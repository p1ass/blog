{
  "name": "basic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler pages dev ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "$npm_execpath run build && wrangler pages deploy ./dist",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "install:playwright": "npx playwright install --with-deps chromium",
    "lint:text": "textlint \"**/*.{md,mdx}\"",
    "lint:text:fix": "textlint --fix \"**/*.{md,mdx}\""
  },
  "private": true,
  "dependencies": {
    "@formkit/tempo": "^1.1.0",
    "hono": "^4.13.7",
    "honox": "0.1.43",
    "ogp-parser": "^0.8.1",
    "rehype-mermaid": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "vite-plugin-require": "^1.2.14",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-ssg": "0.3.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@playwright/test": "1.58.1",
    "@textlint-ja/textlint-rule-morpheme-match": "^2.0.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@types/mdx": "^2.0.13",
    "@types/mdx-js__react": "2.0.0",
    "recma-export-filepath": "^1.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-mdx-code-props": "^3.0.1",
    "rehype-mdx-import-media": "^1.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.61.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "debug@4.4.0": "patches/debug@4.4.0.patch"
    }
  }
}
